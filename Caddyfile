# Caddy reverse proxy for HA Finance Intelligence (see docker-compose.tls.yml).
#
# SITE_ADDRESS controls how Caddy gets its certificate:
#   - a public domain (finance.example.com) → automatic HTTPS via Let's Encrypt
#   - localhost                              → Caddy's built-in local CA (default)
#   - a LAN name/IP (finance.local, 192.168.x.x) → add `tls internal` (see below)
#
# Caddy terminates TLS and forwards plain HTTP to the app container on the Docker
# network. HSTS tells browsers to stick to HTTPS once they've connected.

{$SITE_ADDRESS:localhost} {
	reverse_proxy app:8099
	encode gzip

	# Security headers (CR-SEC-11). Caddy only serves this site over HTTPS (it
	# terminates TLS here), so HSTS is always sent on a real request.
	header {
		# Stick to HTTPS for a year, subdomains included. No trailing ';' —
		# the previous value had one, which is technically tolerated but sloppy.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Stop browsers MIME-sniffing responses into an unintended type.
		X-Content-Type-Options "nosniff"
		# Clickjacking: SAMEORIGIN (not DENY) so the app still loads inside the
		# Home Assistant ingress iframe, matching the backend CSP's
		# `frame-ancestors 'self'` from PR #326.
		X-Frame-Options "SAMEORIGIN"
		# Don't leak the URL to third parties on outbound navigation.
		Referrer-Policy "no-referrer"
		# NOTE: Content-Security-Policy is deliberately NOT set here. The backend
		# (backend/app/main.py, PR #326) owns the CSP and stamps it on every
		# response — including a sha256 hash for the inline theme script. Setting a
		# second policy in Caddy would give two competing headers; the strictest
		# wins per-directive and would almost certainly break the SPA. Let the
		# backend be the single source of truth for CSP.
	}
}

# --- Reaching it by LAN name or IP (no public domain) ------------------------
# Public CAs won't issue for a private name/IP, so use Caddy's internal CA. Replace
# the block above with, e.g.:
#
#   finance.local {
#   	tls internal
#   	reverse_proxy app:8099
#   	encode gzip
#   }
#
# then trust Caddy's root once (the cert lives in the `caddy_data` volume:
# /data/caddy/pki/authorities/local/root.crt). See docs/reverse-proxy.md.
