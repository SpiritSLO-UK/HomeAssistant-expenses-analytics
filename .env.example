# HA Finance Intelligence — standalone settings template
# =============================================================================
# Copy this file to `.env` and edit the values you care about, then start:
#
#   cp .env.example .env          # (Windows: copy .env.example .env)
#   docker compose up -d --build  # docker-compose reads ./.env automatically
#
# Running from source instead of Docker? The backend loads a `.env` from its
# own working directory, so copy this to `backend/.env`:
#
#   cp .env.example backend/.env
#
# Every key is OPTIONAL — anything you leave commented out falls back to the
# default shown. Defaults run the app fully PRIVATE and LOCAL: no external
# calls, AI off, MQTT off. `.env` is git-ignored, so your secrets stay local.
#
# What lives here vs. in the app:
#   * This file = bootstrap + secrets (set once, read at startup).
#   * Most runtime knobs (base currency after first run, AI provider/endpoint/
#     model, OCR on/off, FX mode, retention, log level) are edited in-app on the
#     **Settings** page and stored in the database — they are NOT set here.
#   * Secrets (AI key, Paperless token, DB key) are env-ONLY and never written
#     to the database.
# Full reference: docs/configuration.md
# =============================================================================

# --- Core --------------------------------------------------------------------

# SQLite database file. Under Docker this is forced to the persistent /data
# volume by docker-compose.yml; running from source it defaults to ./data.
#HAFI_DATABASE_PATH=./data/finance.db

# Base (display) currency — what totals are converted to. Amounts are always
# stored in their original currency. Changeable later in Settings.
#HAFI_CURRENCY=GBP

# AI posture. strict_local / no_ai = AI fully off (no external calls).
# local_llm = a local OpenAI-compatible endpoint. cloud_manual = a cloud LLM,
# you approve each request. cloud_auto = a cloud LLM called automatically.
# See docs/privacy.md.
#HAFI_PRIVACY_MODE=strict_local

# --- Server ------------------------------------------------------------------

#HAFI_HOST=0.0.0.0
#HAFI_PORT=8099

# DEBUG / INFO / WARNING / ERROR. Also editable at runtime in Settings → Logging.
#HAFI_LOG_LEVEL=INFO

# --- Integrations: master switches (all OFF by default = strict local) -------

# Publish finance sensors to Home Assistant over MQTT.
#HAFI_MQTT_ENABLED=false
# Local on-device OCR for receipts/scanned statements (needs Tesseract; the
# bundled image includes it).
#HAFI_OCR_ENABLED=false

# --- MQTT (only used when HAFI_MQTT_ENABLED=true) -----------------------------
# Defaults target Home Assistant's Mosquitto add-on.

#HAFI_MQTT_HOST=core-mosquitto
#HAFI_MQTT_PORT=1883
#HAFI_MQTT_USERNAME=
#HAFI_MQTT_PASSWORD=
#HAFI_MQTT_DISCOVERY_PREFIX=homeassistant
#HAFI_MQTT_BASE_TOPIC=homeassistant/finance

# --- AI gateway (opt-in) ------------------------------------------------------
# Secret key for a cloud (or auth'd local) LLM. The endpoint + model are NOT
# secret and are chosen in-app: Settings → AI (e.g. provider openai_compatible,
# base URL https://api.openai.com/v1, model gpt-4o-mini). Needs a real API key —
# a ChatGPT Plus/UI subscription can't be used programmatically.
#HAFI_AI_API_KEY=
# Per-request timeout (seconds).
#HAFI_AI_TIMEOUT_SECONDS=30

# --- Investment price feed (opt-in) ------------------------------------------
# Only the keyed provider (e.g. Alpha Vantage) needs this; the keyless source
# (Stooq) and manual mode need nothing. Only ticker symbols are ever sent.
# Choose the source in Settings → Investment price source.
#HAFI_INVESTMENT_API_KEY=

# --- Paperless-ngx import (opt-in) -------------------------------------------
# One-directional: we only ever request documents FROM your Paperless instance;
# it never receives your finance data. Off unless BOTH are set. The URL may also
# be set in Settings → Integrations (in-app value wins); the token is env-only.
#HAFI_PAPERLESS_URL=http://paperless:8000
#HAFI_PAPERLESS_TOKEN=

# --- Encryption at rest (optional) -------------------------------------------
# SQLCipher passphrase for "stored" unlock mode, so the app can start
# unattended. Leave empty to use "prompt" mode (unlock via the UI each start).
# See docs/security.md.
#HAFI_DB_KEY=
